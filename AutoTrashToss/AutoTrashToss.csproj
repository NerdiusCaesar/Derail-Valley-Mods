<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoTrashToss</AssemblyName>
    <RootNamespace>AutoTrashToss</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Modding framework + game assemblies. <Private>false</Private> = don't copy them into our output. -->
  <ItemGroup>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DV.Interaction">
      <HintPath>$(ManagedDir)\DV.Interaction.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DV.Highlighting">
      <HintPath>$(ManagedDir)\DV.Highlighting.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DV.Utils">
      <HintPath>$(ManagedDir)\DV.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DV.Inventory">
      <HintPath>$(ManagedDir)\DV.Inventory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DV.ThingTypes">
      <HintPath>$(ManagedDir)\DV.ThingTypes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Info.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Deploy into the game's Mods folder after every build. -->
  <Target Name="DeployToGame" AfterTargets="Build">
    <PropertyGroup>
      <DeployDir>$(GameDir)\Mods\$(AssemblyName)</DeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(ProjectDir)Info.json" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="== Deployed $(AssemblyName) to $(DeployDir) ==" />
  </Target>

</Project>
