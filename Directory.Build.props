<!--
  Shared build settings for every project in this repo.
  Change GameDir here if you ever move your Steam library.
-->
<Project>
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Derail Valley</GameDir>
    <ManagedDir>$(GameDir)\DerailValley_Data\Managed</ManagedDir>
  </PropertyGroup>
</Project>
